# WorkSpace Environment Variables Configuration
# Copy this file to .env.local for local development.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/workspace_db

# Supabase Auth & Storage (When connecting real Supabase backend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # NEVER expose to client
